# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://user:password@localhost:5432/covenant_compass"
JWT_SECRET="change-me-to-a-long-random-string"
# Required for /api/system/cron. Vercel Cron sends it as a Bearer token.
CRON_SECRET="change-me-to-a-long-random-string"
# LLM (OpenAI-compatible chat completions).
# Local Ollama: LLM_BASE_URL="http://localhost:11434/v1/", LLM_MODEL="qwen3:4b", LLM_API_KEY="ollama" (ignored but must be non-empty)
# Groq:         LLM_BASE_URL="https://api.groq.com/openai/v1", LLM_MODEL="openai/gpt-oss-20b", LLM_API_KEY="<your Groq key>"
LLM_BASE_URL="http://localhost:11434/v1/"
LLM_API_KEY="ollama"
LLM_MODEL="qwen3:4b"
# Optional: low | medium | high. Only sent when set; use "low" for Groq gpt-oss models.
LLM_REASONING_EFFORT=""
